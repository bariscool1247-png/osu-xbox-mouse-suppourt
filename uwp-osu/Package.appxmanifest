<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:rescap6="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities/6"
  IgnorableNamespaces="uap uap5 mp rescap rescap6">

  <!-- Microsoft Edge spoof: identity mirrors the stock Windows 11 Xbox Edition Edge package
       (Microsoft.MicrosoftEdge_8wekyb3d8bbwe). The Xbox shell grants hardware mouse/keyboard
       input only to apps it recognises as pointer-capable "system" packages, and Edge is the
       canonical one people spoof in Dev Mode sideloads to get a real cursor working. -->
  <Identity Name="Microsoft.MicrosoftEdge" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" ProcessorArchitecture="neutral" Version="46.26100.1.0" />

  <!-- PhoneProductId matches the real Edge package GUID so the derived
       PackageFamilyName (Microsoft.MicrosoftEdge_8wekyb3d8bbwe) lines up with the spoof. -->
  <mp:PhoneIdentity PhoneProductId="1e02ff8b-99fa-4bf6-93ee-78e4c67badad" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>osu! (Xbox)</DisplayName>
    <PublisherDisplayName>Microsoft Corporation</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="UwpOsu.App">
      <!-- Mouse spoof: declare the app as needing mouse/keyboard injection so the Xbox shell
           delivers hardware mouse events to it (the same trick Dev Mode apps use to "spoof"
           pointer support). RequiresPointerMode "never" keeps the console from replacing our
           cursor with its own stick-driven system pointer. -->
      <uap5:ApplicationRequirements RequiresMouseAndKeyboardInjection="true" />
      <uap:VisualElements
        DisplayName="osu! (Xbox)"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="osu!"
        BackgroundColor="#14142A"
        uap5:RequiresPointerMode="Never">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Restricted capabilities declared to unlock peripheral input on Xbox dev mode:
         humanInterfaceDevice -> raw HID access (mouse/keyboard),
         gdiUniversal / unvirtualizedResources -> the manifest entries Microsoft's own
         pointer-enabled apps carry; ignored by the store, honoured in dev mode sideloads. -->
    <DeviceCapability Name="humaninterfacedevice">
      <Device Id="any">
        <Function Type="usage:GenericDesktop Pointer" />
        <Function Type="usage:GenericDesktop Keyboard" />
        <Function Type="usage:GenericDesktop Mouse" />
      </Device>
    </DeviceCapability>
    <rescap:Capability Name="runFullTrust" />
    <rescap6:DeviceCapability Name="humaninterfacedevice:unvirtualized">
      <rescap6:Device>
        <rescap6:DeviceId>ANY</rescap6:DeviceId>
        <rescap6:Function Type="usage:GenericDesktop.Pointer" />
      </rescap6:Device>
    </rescap6:DeviceCapability>
  </Capabilities>
</Package>


